# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Optional OpenAI-compatible AI provider configuration (server-side fallback)
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=

# Optional Turso (libSQL) cloud backup configuration (server-side only)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
